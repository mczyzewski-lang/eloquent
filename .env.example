# =============================================================================
# Elofik — zmienne środowiskowe
# Skopiuj do .env.local (dev) lub ustaw w Railway (staging/production).
# Wszystkie klucze bez prefiksu NEXT_PUBLIC_ są dostępne WYŁĄCZNIE po stronie serwera.
# =============================================================================

# --- Środowisko -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# Kanoniczny adres aplikacji. Produkcja: https://elofik.com (bez www, bez końcowego /)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Min. 32 znaki losowe (openssl rand -base64 48). Podpisuje cookies demo, URL-e mediów i tokeny prezentów.
SESSION_SECRET=
# 1 = wymuś tryb demo (dane w .data/, mocki AI, symulacja płatności) nawet przy ustawionym Supabase
ELOFIK_DEMO_MODE=
# Katalog danych trybu demo
ELOFIK_DATA_DIR=.data
# Adresy e-mail administratorów (oddzielone przecinkami)
ADMIN_EMAILS=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=audio
SUPABASE_IMAGE_BUCKET=images

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cena „ELOFIK PREMIUM” 39,90 zł brutto / miesiąc (recurring)
STRIPE_PRICE_PREMIUM_MONTHLY=
# Cena prezentu 39,90 zł brutto (one-time). Puste = cena inline w Checkout.
STRIPE_PRICE_GIFT_MONTH=
# Kupon 100% na 1 miesiąc (nagroda za 3 polecenia), duration=once
STRIPE_COUPON_REFERRAL_MONTH=

# --- ElevenLabs -------------------------------------------------------------
ELEVENLABS_API_KEY=
# Głos Elofika (Voice ID z biblioteki ElevenLabs)
ELEVENLABS_VOICE_ID=
# Podbij przy zmianie głosu/ustawień — nowe nagrania powstaną pod nowym kluczem cache
ELEVENLABS_VOICE_VERSION=VOICE_V1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Do estymacji kosztów w panelu (sprawdź aktualny cennik swojego planu)
ELEVENLABS_TTS_USD_PER_1K_CHARS=0.18
ELEVENLABS_STT_USD_PER_MINUTE=0.0067

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Budżet AI (bez limitu > 0 płatne generowanie jest zablokowane) ------------
AI_MONTHLY_BUDGET_USD=0
AI_SAMPLE_DAILY_BUDGET_USD=5

# --- Rytuał głosowy -----------------------------------------------------------
VOICE_SESSION_MAX_SECONDS=8
VOICE_MAX_ATTEMPTS_PER_STORY=4
VOICE_MAX_SESSIONS_PER_DAY=20

# --- Odblokowywanie -----------------------------------------------------------
UNLOCK_HOUR=6
DEFAULT_TIMEZONE=Europe/Warsaw

# --- E-mail (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Elofik <bajki@elofik.com>"

# --- Cron / worker ------------------------------------------------------------
CRON_SECRET=
WORKER_IDLE_MS=3000

# --- Logowanie administratora hasłem (/logowanie/admin) ---------------------
# Skrót scrypt hasła: node scripts/hash-password.mjs   (hasło nigdy nie trafia do repozytorium)
ADMIN_PASSWORD_HASH=
